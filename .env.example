# ─────────────────────────────────────────────────────────────
# Tribunal — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres) ---
# Pooled connection (Supavisor, transaction mode, port 6543) for the running app:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session connection (port 5432) used by `prisma migrate deploy`:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (public values; safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# --- Local-only auth bypass (laptop trials without Supabase). Refused on Vercel. ---
# AUTH_MODE="dev-local"

# --- Encryption for user-supplied API keys (32 bytes, base64) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Optional server-level provider keys (users can add their own in Settings) ---
TWELVE_DATA_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
# TWELVE_DATA | ALPHA_VANTAGE — which server key to prefer when both are set
MARKET_DATA_PROVIDER="TWELVE_DATA"
# Comma-separated exchanges for which your data plan is genuinely real-time
# (e.g. "NASDAQ,NYSE"). Leave empty to label intraday prices as delayed.
MARKET_DATA_REALTIME_EXCHANGES=""

# AI providers (used from Phase 3)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Logging: debug | info | warn | error ---
LOG_LEVEL="info"
